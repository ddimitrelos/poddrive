-- PodDrive: episodes and episode_tiers tables
-- episodes: Cached unheard episodes from followed podcasts.
-- episode_tiers: Per-episode LOVED/LIKED tier (inherited from podcast tier at sync time).
-- All timestamps are Unix ms (INTEGER). IDs are Spotify URIs (TEXT).

CREATE TABLE episodes (
    id TEXT NOT NULL PRIMARY KEY,
    podcast_id TEXT NOT NULL REFERENCES podcasts(id) ON DELETE CASCADE,
    title TEXT NOT NULL,
    duration_ms INTEGER NOT NULL,
    published_at INTEGER NOT NULL,
    is_played INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE episode_tiers (
    episode_id TEXT NOT NULL PRIMARY KEY REFERENCES episodes(id) ON DELETE CASCADE,
    tier TEXT NOT NULL DEFAULT 'NONE'
);

-- Queries: episodes

selectById:
SELECT * FROM episodes WHERE id = ?;

selectUnplayedByPodcast:
SELECT * FROM episodes
WHERE podcast_id = ? AND is_played = 0
ORDER BY published_at DESC;

selectAllUnplayed:
SELECT * FROM episodes WHERE is_played = 0 ORDER BY published_at DESC;

selectUnplayedOrderedByTier:
SELECT e.id, e.podcast_id, e.title, e.duration_ms, e.published_at, e.is_played,
       COALESCE(et.tier, 'NONE') AS tier
FROM episodes e
LEFT JOIN episode_tiers et ON e.id = et.episode_id
WHERE e.is_played = 0
ORDER BY
    CASE COALESCE(et.tier, 'NONE')
        WHEN 'LOVED' THEN 0
        WHEN 'LIKED' THEN 1
        ELSE 2
    END,
    e.published_at DESC;

upsertEpisode:
INSERT OR REPLACE INTO episodes(id, podcast_id, title, duration_ms, published_at, is_played)
VALUES (?, ?, ?, ?, ?, ?);

markPlayed:
UPDATE episodes SET is_played = 1 WHERE id = ?;

markUnplayed:
UPDATE episodes SET is_played = 0 WHERE id = ?;

deleteByPodcast:
DELETE FROM episodes WHERE podcast_id = ?;

deleteAll:
DELETE FROM episodes;

-- Queries: episode_tiers

selectTierForEpisode:
SELECT tier FROM episode_tiers WHERE episode_id = ?;

upsertTier:
INSERT OR REPLACE INTO episode_tiers(episode_id, tier) VALUES (?, ?);

deleteTier:
DELETE FROM episode_tiers WHERE episode_id = ?;

deleteAllTiers:
DELETE FROM episode_tiers;

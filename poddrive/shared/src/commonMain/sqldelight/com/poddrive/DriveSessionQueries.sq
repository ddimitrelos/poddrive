-- PodDrive: drive_sessions and playback_state tables
-- drive_sessions: Persists the drive session lifecycle for OS-kill recovery (NFR11, AR6).
-- playback_state: Single-row table tracking last known episode position.
-- All timestamps are Unix ms (INTEGER). IDs are TEXT.

CREATE TABLE drive_sessions (
    id TEXT NOT NULL PRIMARY KEY,
    state TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    ended_at INTEGER,
    updated_at INTEGER NOT NULL
);

-- Single-row table; use id = 'singleton' always.
CREATE TABLE playback_state (
    id TEXT NOT NULL PRIMARY KEY,
    episode_id TEXT,
    position_ms INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL DEFAULT 0
);

-- Queries: drive_sessions

selectLatestSession:
SELECT * FROM drive_sessions ORDER BY started_at DESC LIMIT 1;

selectSessionById:
SELECT * FROM drive_sessions WHERE id = ?;

upsertSession:
INSERT OR REPLACE INTO drive_sessions(id, state, started_at, ended_at, updated_at)
VALUES (?, ?, ?, ?, ?);

updateSessionState:
UPDATE drive_sessions SET state = ?, updated_at = ? WHERE id = ?;

endSession:
UPDATE drive_sessions SET state = 'Ended', ended_at = ?, updated_at = ? WHERE id = ?;

deleteAllSessions:
DELETE FROM drive_sessions;

-- Queries: playback_state
-- Always use id = 'singleton'. Only one row should exist.

selectPlaybackState:
SELECT * FROM playback_state WHERE id = 'singleton';

upsertPlaybackState:
INSERT OR REPLACE INTO playback_state(id, episode_id, position_ms, updated_at)
VALUES ('singleton', ?, ?, ?);

clearPlaybackState:
DELETE FROM playback_state WHERE id = 'singleton';

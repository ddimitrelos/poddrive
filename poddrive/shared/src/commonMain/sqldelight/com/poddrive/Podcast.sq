-- PodDrive: podcasts table
-- Stores followed Spotify podcasts with LOVED/LIKED tier and sync metadata.
-- id: Spotify show URI e.g. "spotify:show:abc123"
-- tier: 'LOVED' | 'LIKED' | 'NONE'
-- last_synced_at: Unix ms timestamp of last successful sync

CREATE TABLE podcasts (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    image_url TEXT NOT NULL DEFAULT '',
    episode_count INTEGER NOT NULL DEFAULT 0,
    tier TEXT NOT NULL DEFAULT 'NONE'
        CHECK (tier IN ('LOVED', 'LIKED', 'NONE')),
    last_synced_at INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM podcasts;

selectById:
SELECT * FROM podcasts WHERE id = ?;

selectByTier:
SELECT * FROM podcasts WHERE tier = ?;

upsert:
INSERT INTO podcasts(id, name, description, image_url, episode_count, tier, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    name = excluded.name,
    description = excluded.description,
    image_url = excluded.image_url,
    episode_count = excluded.episode_count,
    tier = excluded.tier,
    last_synced_at = excluded.last_synced_at;

updateTier:
UPDATE podcasts SET tier = ? WHERE id = ?;

updateLastSyncedAt:
UPDATE podcasts SET last_synced_at = ? WHERE id = ?;

deletePodcast:
DELETE FROM podcasts WHERE id = ?;

deleteAll:
DELETE FROM podcasts;

countAll:
SELECT COUNT(*) FROM podcasts;

-- COALESCE returns 0 when the table is empty rather than propagating NULL to callers.
selectMostRecentSyncTime:
SELECT COALESCE(MAX(last_synced_at), 0) FROM podcasts;

selectAllWithUnheardCount:
SELECT p.id, p.name, p.description, p.image_url, p.episode_count, p.tier, p.last_synced_at,
       COALESCE(COUNT(e.id), 0) AS unheard_count
FROM podcasts p
LEFT JOIN episodes e ON p.id = e.podcast_id AND e.is_played = 0
GROUP BY p.id
ORDER BY p.name ASC;

selectAllWithUnheardCountByTier:
SELECT p.id, p.name, p.description, p.image_url, p.episode_count, p.tier, p.last_synced_at,
       COALESCE(COUNT(e.id), 0) AS unheard_count
FROM podcasts p
LEFT JOIN episodes e ON p.id = e.podcast_id AND e.is_played = 0
WHERE p.tier = ?
GROUP BY p.id
ORDER BY p.name ASC;
